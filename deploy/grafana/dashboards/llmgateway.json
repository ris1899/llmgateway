          },
          "expr": "sum by (deployment, outcome) (rate(llmgw_upstream_attempts_total[1m]))",
          "legendFormat": "{{deployment}} / {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Breaker state per deployment",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "green"
                },
                "1": {
                  "text": "open",
                  "color": "red"
                },
                "2": {
                  "text": "half-open",
                  "color": "yellow"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "llmgw_breaker_state",
          "legendFormat": "{{deployment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(llmgw_cache_lookups_total{result=\"hit\"}[1m])) / (sum(rate(llmgw_cache_lookups_total{result=\"hit\"}[1m])) + sum(rate(llmgw_cache_lookups_total{result=\"miss\"}[1m])))",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ]
    },
